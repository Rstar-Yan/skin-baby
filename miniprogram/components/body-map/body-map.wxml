<view class="body-map-wrap">
  <svg viewBox="0 0 200 260" xmlns="http://www.w3.org/2000/svg" class="body-svg">
    <!-- 身体轮廓 -->
    <ellipse cx="100" cy="28" rx="28" ry="22" fill="#F0F4F8" stroke="#D8DEE4" stroke-width="1.5"/>
    <line x1="100" y1="50" x2="100" y2="100" stroke="#D8DEE4" stroke-width="1.5"/>
    <rect x="72" y="60" width="56" height="80" rx="16" fill="#F5F7FA" stroke="#D8DEE4" stroke-width="1.5"/>
    <line x1="72" y1="78" x2="44" y2="108" stroke="#D8DEE4" stroke-width="1.5"/>
    <line x1="128" y1="78" x2="156" y2="108" stroke="#D8DEE4" stroke-width="1.5"/>
    <line x1="44" y1="108" x2="36" y2="150" stroke="#D8DEE4" stroke-width="1.5"/>
    <line x1="156" y1="108" x2="164" y2="150" stroke="#D8DEE4" stroke-width="1.5"/>
    <line x1="100" y1="140" x2="80" y2="194" stroke="#D8DEE4" stroke-width="1.5"/>
    <line x1="100" y1="140" x2="120" y2="194" stroke="#D8DEE4" stroke-width="1.5"/>

    <!-- 部位点 (通过列表渲染) -->
    <circle wx:for="{{dots}}" wx:key="id"
            cx="{{item.cx}}" cy="{{item.cy}}" r="7"
            class="body-dot {{selectedIds.indexOf(item.id) >= 0 ? 'selected' : ''}}"
            fill="{{selectedIds.indexOf(item.id) >= 0 ? '#D9534F' : '#C0CAD4'}}"
            data-id="{{item.id}}"
            bindtap="onDotTap">
    </circle>

    <!-- 标签（仅左侧部位显示名称） -->
    <text class="body-label" x="14" y="22">头顶</text>
    <text class="body-label" x="30" y="34">面部</text>
    <text class="body-label" x="30" y="60">颈部</text>
    <text class="body-label" x="10" y="124">手肘</text>
    <text class="body-label" x="10" y="158">手腕</text>
    <text class="body-label" x="10" y="200">膝盖</text>
    <text class="body-label" x="30" y="244">脚踝</text>
  </svg>
</view>