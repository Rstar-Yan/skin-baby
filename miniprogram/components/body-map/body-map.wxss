.body-map-wrap {
  width: 100%; position: relative;
}
.body-svg {
  width: 100%; height: 520rpx;
}
.body-dot {
  stroke: #fff; stroke-width: 2;
  transition: fill 0.25s ease;
}
.body-dot:hover { r: 10; }
.body-dot.selected { stroke-width: 3; }

.body-label {
  font-size: 18rpx; fill: #636E72;
  pointer-events: none; font-weight: 500;
}