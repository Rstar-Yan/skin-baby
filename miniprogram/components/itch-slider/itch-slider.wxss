.slider-wrap {
  background: #fff; border-radius: 20rpx;
  padding: 40rpx 32rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.slider-header {
  display: flex; justify-content: space-between; align-items: baseline;
  margin-bottom: 32rpx;
}
.title { font-size: 28rpx; font-weight: 600; color: #2D3436; }
.score { font-size: 72rpx; font-weight: 700; color: #2D3436; line-height: 1; }

.slider-body { position: relative; height: 80rpx; }
.slider-rail {
  position: absolute; top: 28rpx; left: 0; right: 0; height: 20rpx;
  border-radius: 10rpx;
  background: linear-gradient(to right, #52B788, #D4A843, #D9534F);
}
.slider-thumb {
  position: absolute; top: 4rpx; width: 68rpx; height: 68rpx;
  background: #fff; border-radius: 50%;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.2);
  transform: translateX(-50%);
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: #2D3436;
}

.slider-ticks {
  display: flex; justify-content: space-between;
  padding: 0 4rpx; margin-top: 4rpx;
}
.slider-ticks text { font-size: 18rpx; color: #9AA0A6; width: 32rpx; text-align: center; }

.slider-desc {
  text-align: center; font-size: 28rpx; font-weight: 500;
  margin-top: 16rpx; color: #636E72;
}
.slider-desc.none { color: #52B788; }
.slider-desc.mild { color: #D4A843; }
.slider-desc.severe { color: #D9534F; }