<view class="container">
  <!-- 欢迎区 -->
  <view class="welcome-row">
    <view class="avatar-circle">{{userInfo.avatar}}</view>
    <view class="welcome-text">
      <view class="greeting">下午好，{{userInfo.name}}妈妈</view>
      <view class="name">今天护理做好了吗？</view>
    </view>
  </view>

  <!-- 状态卡片网格 -->
  <view class="status-grid">
    <view class="status-card" bindtap="onMoisturize">
      <view class="sc-stripe green"></view>
      <view class="sc-icon">🧴</view>
      <view class="sc-label">今日润肤</view>
      <view class="sc-value">{{todayStatus.moisturizing.current}}<text class="sc-unit">/{{todayStatus.moisturizing.target}} 次</text></view>
      <view class="sc-badge {{todayStatus.moisturizing.done ? 'done' : 'todo'}}"></view>
    </view>

    <view class="status-card" bindtap="onQuickRecord">
      <view class="sc-stripe amber"></view>
      <view class="sc-icon">🩺</view>
      <view class="sc-label">瘙痒评分</view>
      <view class="sc-value">{{todayStatus.itchScore}}<text class="sc-unit"> 分</text></view>
      <view class="sc-badge todo amber-dot"></view>
    </view>

    <view class="status-card">
      <view class="sc-stripe blue-stripe"></view>
      <view class="sc-icon">💊</view>
      <view class="sc-label">今日用药</view>
      <view class="sc-value sc-done-text">{{todayStatus.medication.taken ? '已完成' : '待用药'}}</view>
      <view class="sc-badge {{todayStatus.medication.taken ? 'done' : 'todo'}}"></view>
    </view>

    <view class="status-card" bindtap="onQuickRecord">
      <view class="sc-stripe blue-stripe"></view>
      <view class="sc-icon">📸</view>
      <view class="sc-label">今日拍照</view>
      <view class="sc-value sc-pending-text">{{todayStatus.photoTaken ? '已记录' : '未记录'}}</view>
    </view>
  </view>

  <!-- 环境卡片 -->
  <view class="env-card">
    <text class="env-icon">🌤️</text>
    <view class="env-info">
      <view class="env-temp">{{todayStatus.environment.city}} {{todayStatus.environment.temp}}°</view>
      <view class="env-humi">湿度 {{todayStatus.environment.humidity}}% · 较干燥</view>
    </view>
    <view class="env-tip">⚠️ 加强润肤</view>
  </view>

  <!-- 可疑诱因洞察 -->
  <view class="trigger-insight" bindtap="onQuickRecord">
    <view class="ti-icon-wrap"><text class="ti-icon">🔍</text></view>
    <view class="ti-info">
      <view class="ti-title">本月可疑诱因</view>
      <view class="ti-desc">{{triggerInsight.description}}</view>
    </view>
    <view class="ti-badge">⚠️ 高关联</view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-row">
    <button class="quick-btn primary" bindtap="onQuickRecord">📸 拍照记录</button>
    <button class="quick-btn secondary" bindtap="onMoisturize">🧴 润肤打卡</button>
  </view>

  <!-- 最近记录 -->
  <view class="section-label">最近记录</view>
  <scroll-view scroll-x class="photo-history" wx:if="{{recentRecords.length}}">
    <view class="photo-thumb" wx:for="{{recentRecords}}" wx:key="date" bindtap="onViewTrends">
      <text>{{item.icon}}</text>
      <text class="thumb-area">{{item.area}}</text>
      <text class="thumb-date">{{item.date}}</text>
    </view>
  </scroll-view>
</view>