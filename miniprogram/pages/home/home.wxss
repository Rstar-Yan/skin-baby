.welcome-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx 32rpx 28rpx;
}
.avatar-circle {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: linear-gradient(135deg, #E8F0FB, #EDE0F5);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}
.welcome-text { flex: 1; }
.greeting { font-size: 26rpx; color: #636E72; }
.name { font-size: 34rpx; font-weight: 700; color: #2D3436; margin-top: 4rpx; }

/* 状态网格 */
.status-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 16rpx; margin: 0 24rpx 24rpx;
}
.status-card {
  background: #fff; border-radius: 20rpx;
  padding: 28rpx 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative; overflow: hidden;
}
.status-card:active { transform: scale(0.97); opacity: 0.85; }
.sc-stripe { position: absolute; top:0; left:0; width:100%; height:6rpx; }
.sc-stripe.green { background: #52B788; }
.sc-stripe.amber { background: #D4A843; }
.sc-stripe.blue-stripe { background: #4A90D9; }
.sc-icon { font-size: 44rpx; margin-bottom: 14rpx; }
.sc-label { font-size: 24rpx; color: #636E72; }
.sc-value { font-size: 48rpx; font-weight: 700; color: #2D3436; margin-top: 4rpx; }
.sc-unit { font-size: 26rpx; font-weight: 400; color: #636E72; }
.sc-done-text { font-size: 30rpx; color: #52B788; }
.sc-pending-text { font-size: 30rpx; color: #9AA0A6; }

.sc-badge {
  position: absolute; top: 24rpx; right: 24rpx;
  width: 20rpx; height: 20rpx; border-radius: 50%;
}
.sc-badge.done { background: #52B788; box-shadow: 0 0 0 6rpx #E8F5EE; }
.sc-badge.todo { background: #D4A843; box-shadow: 0 0 0 6rpx #FBF3E0; }
.sc-badge.amber-dot { background: #D4A843; box-shadow: 0 0 0 6rpx #FBF3E0; }

/* 环境卡片 */
.env-card {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff; border-radius: 20rpx;
  padding: 24rpx 28rpx; margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.env-icon { font-size: 60rpx; }
.env-info { flex: 1; }
.env-temp { font-size: 40rpx; font-weight: 700; color: #2D3436; }
.env-humi { font-size: 24rpx; color: #636E72; margin-top: 4rpx; }
.env-tip {
  font-size: 24rpx; color: #D9534F; background: #FDEAEA;
  padding: 10rpx 24rpx; border-radius: 40rpx; font-weight: 500;
}

/* 诱因洞察 */
.trigger-insight {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff; border-radius: 20rpx;
  padding: 24rpx 28rpx; margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.ti-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 16rpx;
  background: #FBF3E0; display: flex; align-items: center; justify-content: center;
}
.ti-icon { font-size: 36rpx; }
.ti-info { flex: 1; }
.ti-title { font-size: 28rpx; font-weight: 600; color: #2D3436; }
.ti-desc { font-size: 22rpx; color: #9AA0A6; margin-top: 6rpx; }
.ti-badge {
  font-size: 22rpx; font-weight: 600; color: #D4A843;
  background: #FBF3E0; padding: 8rpx 20rpx; border-radius: 40rpx;
}

/* 快捷操作 */
.quick-row {
  display: flex; gap: 16rpx; margin: 0 24rpx 28rpx;
}
.quick-btn {
  flex: 1; height: 96rpx; border-radius: 16rpx;
  font-size: 28rpx; font-weight: 600; border: none;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 0; line-height: 96rpx;
}
.quick-btn.primary { background: #4A90D9; color: #fff; }
.quick-btn.primary:active { background: #3A7BC8; }
.quick-btn.secondary { background: #fff; color: #4A90D9; border: 2rpx solid #4A90D9; }
.quick-btn.secondary:active { background: #E8F0FB; }

/* 最近记录 */
.section-label {
  font-size: 24rpx; font-weight: 700; color: #9AA0A6;
  letter-spacing: 0.06em; padding: 0 32rpx; margin-bottom: 16rpx;
}
.photo-history {
  display: flex; gap: 16rpx; padding: 0 24rpx 16rpx;
  white-space: nowrap;
}
.photo-thumb {
  width: 144rpx; height: 144rpx; border-radius: 16rpx;
  background: #E8F0FB; flex-shrink: 0;
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; gap: 8rpx;
  font-size: 22rpx; color: #636E72;
}
.photo-thumb:active { transform: scale(0.93); }
.thumb-area { font-size: 22rpx; }
.thumb-date { font-size: 18rpx; color: #9AA0A6; }