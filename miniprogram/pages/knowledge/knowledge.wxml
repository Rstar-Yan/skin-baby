<view class="container">
  <view class="k-section" wx:for="{{sections}}" wx:key="category">
    <view class="k-section-title">
      <view class="k-dot" style="background:{{item.dotColor}};"></view>
      {{item.categoryName}}
    </view>

    <view class="k-card" wx:for="{{item.items}}" wx:key="id" data-title="{{article.title}}" bindtap="onArticleTap">
      <view class="k-card-icon {{article.iconBg}}">{{article.icon}}</view>
      <view class="k-card-info">
        <view class="k-title">{{article.title}}</view>
        <view class="k-desc">{{article.desc}}</view>
      </view>
      <text class="k-card-arrow">›</text>
    </view>
  </view>

  <view style="height:32rpx;"></view>
</view>