.k-section { margin-bottom: 40rpx; padding: 0 24rpx; }
.k-section-title {
  font-size: 28rpx; font-weight: 700; color: #636E72;
  margin-bottom: 20rpx; display: flex; align-items: center; gap: 16rpx;
}
.k-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
}

.k-card {
  background: #fff; border-radius: 16rpx;
  padding: 28rpx 32rpx; margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  display: flex; align-items: center; gap: 24rpx;
}
.k-card:active { transform: scale(0.985); }
.k-card-icon {
  width: 80rpx; height: 80rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; flex-shrink: 0;
}
.k-card-info { flex: 1; }
.k-title { font-size: 28rpx; font-weight: 600; color: #2D3436; }
.k-desc { font-size: 22rpx; color: #9AA0A6; margin-top: 6rpx; }
.k-card-arrow { color: #9AA0A6; font-size: 32rpx; font-weight: 300; }