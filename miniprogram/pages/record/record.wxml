<view class="container">
  <!-- 拍照区域 -->
  <view class="photo-zone" bindtap="onTakePhoto">
    <text class="cam-icon">📷</text>
    <text class="cam-hint">点击拍摄皮损部位</text>
    <text class="cam-sub">对准宝宝患处，光线充足时拍摄效果最佳</text>
  </view>

  <!-- 人体图组件 -->
  <view class="body-map-container">
    <view class="body-map-title">选择受累部位（可多选）</view>
    <body-map bind:areaselect="onAreaSelect" />
    <view class="selected-areas">
      <view class="area-tag" wx:for="{{selectedAreas}}" wx:key="*this" data-area="{{item}}" bindtap="onAreaRemove">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 瘙痒评分滑块 -->
  <view class="slider-container">
    <itch-slider score="{{itchScore}}" bind:scorechange="onItchChange" />
  </view>

  <!-- 保存按钮 -->
  <button class="save-btn" bindtap="onSave">保存记录</button>

  <!-- 诱因选择 -->
  <view class="trigger-section">
    <view class="trigger-title">⚠️ 疑似诱因（多选，帮助发现发作规律）</view>

    <view class="trigger-cat" wx:for="{{triggerCategories}}" wx:key="id">
      <view class="trigger-cat-label">{{item.icon}} {{item.name}}</view>
      <view class="trigger-tags">
        <view class="trigger-tag {{selectedTriggers.indexOf(item.id + ':' + tag) >= 0 ? 'selected' : ''}}"
              wx:for="{{item.tags}}" wx:key="*this" data-cat-id="{{item.id}}" data-tag="{{tag}}"
              bindtap="onTriggerToggle">
          {{tag}}
        </view>
      </view>
    </view>

    <input class="trigger-custom" placeholder="补充其他诱因（选填）" value="{{customTrigger}}" bindinput="onCustomInput" />
  </view>
</view>