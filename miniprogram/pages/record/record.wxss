.photo-zone {
  width: 100%; height: 360rpx;
  background: #F8F9FA; border: 4rpx dashed #D8DEE4;
  border-radius: 20rpx; margin: 0 24rpx 32rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.photo-zone:active { border-color: #4A90D9; background: #E8F0FB; }
.cam-icon { font-size: 80rpx; margin-bottom: 16rpx; opacity: 0.7; }
.cam-hint { font-size: 28rpx; color: #636E72; font-weight: 500; }
.cam-sub { font-size: 22rpx; color: #9AA0A6; margin-top: 8rpx; }

/* 人体图容器 */
.body-map-container {
  background: #fff; border-radius: 20rpx;
  padding: 32rpx; margin: 0 24rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.body-map-title {
  font-size: 26rpx; font-weight: 600; color: #636E72;
  margin-bottom: 20rpx;
}
.selected-areas {
  display: flex; gap: 12rpx; flex-wrap: wrap;
  margin-top: 20rpx; min-height: 56rpx;
}
.area-tag {
  padding: 8rpx 24rpx; border-radius: 40rpx;
  font-size: 22rpx; font-weight: 500; background: #FDEAEA;
  color: #D9534F; display: inline-block;
}
.area-tag:active { opacity: 0.7; }

/* 滑块容器 */
.slider-container {
  margin: 0 24rpx 32rpx;
}

/* 保存按钮 */
.save-btn {
  width: calc(100% - 48rpx); height: 100rpx; border-radius: 16rpx;
  background: #4A90D9; color: #fff; border: none;
  font-size: 32rpx; font-weight: 700; margin: 0 24rpx 32rpx;
}
.save-btn:active { background: #3A7BC8; }

/* 诱因选择 */
.trigger-section {
  background: #fff; border-radius: 20rpx;
  padding: 32rpx; margin: 0 24rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.trigger-title {
  font-size: 26rpx; font-weight: 600; color: #D9534F;
  margin-bottom: 24rpx; display: flex; align-items: center; gap: 8rpx;
}
.trigger-cat { margin-bottom: 24rpx; }
.trigger-cat:last-child { margin-bottom: 0; }
.trigger-cat-label {
  font-size: 22rpx; font-weight: 600; color: #636E72;
  margin-bottom: 12rpx; display: flex; align-items: center; gap: 8rpx;
}
.trigger-tags {
  display: flex; gap: 12rpx; flex-wrap: wrap;
}
.trigger-tag {
  padding: 10rpx 24rpx; border-radius: 40rpx;
  font-size: 22rpx; font-weight: 500; background: #F8F9FA;
  color: #636E72; border: 3rpx solid transparent;
  user-select: none;
}
.trigger-tag:active { transform: scale(0.94); }
.trigger-tag.selected {
  background: #FDEAEA; color: #D9534F;
  border-color: #D9534F;
}
.trigger-custom {
  width: 100%; padding: 20rpx 24rpx; border-radius: 16rpx;
  border: 1px solid #E8ECF0; font-size: 24rpx;
  color: #2D3436; background: #F8F9FA; margin-top: 20rpx;
  outline: none;
}
.trigger-custom:focus { border-color: #4A90D9; }
.trigger-custom::placeholder { color: #9AA0A6; }