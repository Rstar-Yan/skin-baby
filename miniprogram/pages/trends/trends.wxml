<view class="container">
  <!-- 周期切换 -->
  <view class="trend-tabs">
    <view class="trend-tab {{trendTab === 'week' ? 'active' : ''}}" data-tab="week" bindtap="switchTab">本周</view>
    <view class="trend-tab {{trendTab === 'month' ? 'active' : ''}}" data-tab="month" bindtap="switchTab">本月</view>
  </view>

  <!-- 图表卡片 -->
  <view class="chart-card" wx:if="{{trendTab === 'week'}}">
    <view class="chart-card-title">瘙痒评分趋势 · 本周</view>
    <canvas type="2d" id="weekChart" class="chart-canvas" wx:if="{{weekData.days}}"></canvas>
    <view class="chart-summary">
      <view class="chart-stat">
        <view class="stat-val color-red">{{weekData.highest}}</view>
        <view class="stat-label">最高评分</view>
      </view>
      <view class="chart-stat">
        <view class="stat-val">{{weekData.average}}</view>
        <view class="stat-label">平均评分</view>
      </view>
      <view class="chart-stat">
        <view class="stat-val color-green">{{weekData.lowest}}</view>
        <view class="stat-label">最低评分</view>
      </view>
    </view>
  </view>

  <view class="chart-card" wx:if="{{trendTab === 'month'}}">
    <view class="chart-card-title">瘙痒评分趋势 · 本月</view>
    <canvas type="2d" id="monthChart" class="chart-canvas" wx:if="{{monthData.dates}}"></canvas>
    <view class="chart-summary">
      <view class="chart-stat">
        <view class="stat-val color-red">{{monthData.highest}}</view>
        <view class="stat-label">最高评分</view>
      </view>
      <view class="chart-stat">
        <view class="stat-val">{{monthData.average}}</view>
        <view class="stat-label">平均评分</view>
      </view>
      <view class="chart-stat">
        <view class="stat-val color-green">{{monthData.lowest}}</view>
        <view class="stat-label">最低评分</view>
      </view>
    </view>
  </view>

  <!-- 用药日历 -->
  <view class="med-calendar card">
    <view class="med-cal-title">用药日历 · 2026年5月</view>
    <view class="weekday-row">
      <text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text>
    </view>
    <view class="cal-row" wx:for="{{calendar}}" wx:key="*this">
      <text class="cal-day {{item.empty ? 'empty' : ''}} {{item.today ? 'today' : ''}} {{item.med ? 'med-day' : ''}}"
            wx:for="{{item}}" wx:for-item="cell" wx:key="day">
        {{cell.empty ? '' : cell.day}}
      </text>
    </view>
    <view class="cal-legend">
      <view class="cal-legend-item"><view class="cal-dot red"></view> 激素用药日</view>
      <view class="cal-legend-item"><view class="cal-dot blue"></view> 今天</view>
    </view>
  </view>
</view>