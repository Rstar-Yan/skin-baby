.trend-tabs {
  display: flex; gap: 8rpx;
  background: #F0F2F5; border-radius: 40rpx;
  padding: 8rpx; margin: 0 24rpx 32rpx;
}
.trend-tab {
  flex: 1; padding: 16rpx 0; border-radius: 40rpx;
  border: none; background: transparent; font-size: 26rpx;
  font-weight: 600; color: #636E72; text-align: center;
}
.trend-tab.active { background: #fff; color: #2D3436; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }

/* 图表卡片 */
.chart-card {
  margin: 0 24rpx 24rpx; background: #fff;
  border-radius: 20rpx; padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.chart-card-title { font-size: 28rpx; font-weight: 600; color: #2D3436; margin-bottom: 16rpx; }
.chart-canvas { width: 100%; height: 360rpx; }

.chart-summary {
  display: flex; gap: 16rpx; margin-top: 24rpx;
}
.chart-stat {
  flex: 1; text-align: center; padding: 20rpx 8rpx;
  background: #F8F9FA; border-radius: 16rpx;
}
.stat-val { font-size: 44rpx; font-weight: 700; color: #2D3436; }
.stat-label { font-size: 22rpx; color: #636E72; margin-top: 4rpx; }

/* 用药日历 */
.med-calendar { padding: 32rpx; }
.med-cal-title { font-size: 28rpx; font-weight: 600; color: #2D3436; margin-bottom: 20rpx; }

.weekday-row { display: flex; margin-bottom: 8rpx; }
.weekday-row text {
  flex: 1; text-align: center; font-size: 20rpx; color: #9AA0A6;
}

.cal-row { display: flex; margin-bottom: 4rpx; }
.cal-day {
  flex: 1; aspect-ratio: 1; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 600; color: #2D3436;
  position: relative; margin: 2rpx;
}
.cal-day.empty { opacity: 0; }
.cal-day.today { background: #E8F0FB; color: #4A90D9; }
.cal-day.med-day { background: #FDEAEA; color: #D9534F; }
.cal-day.med-day::after {
  content: ''; position: absolute; bottom: 4rpx;
  width: 8rpx; height: 8rpx; background: #D9534F; border-radius: 50%;
}

.cal-legend {
  display: flex; gap: 32rpx; margin-top: 24rpx;
  font-size: 22rpx; color: #636E72;
}
.cal-legend-item { display: flex; align-items: center; gap: 8rpx; }
.cal-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.cal-dot.red { background: #D9534F; }
.cal-dot.blue { background: #4A90D9; }